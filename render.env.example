# ใช้กับปุ่ม "Add from .env" ในหน้า Render (Environment Variables) — แก้ค่าที่มี <...> ก่อนวาง
# ชื่อบริการสมมติเป็น wavevy-council → https://web-ykbc.onrender.com (ถ้าชื่อไม่ตรง แก้ทุกที่ที่เป็นโดเมน)
APP_NAME=WAVEVY COUNCIL
APP_ENV=production
APP_DEBUG=false
APP_KEY=<ผลจาก: php artisan key:generate --show> 
APP_URL=https://web-ykbc.onrender.com
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr
FRONTEND_URL=https://web-ykbc.onrender.com
TRUSTED_PROXIES=*

DB_CONNECTION=pgsql
DB_URL=<Internal Database URL จาก Postgres ของ Render>

SESSION_DRIVER=database
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=web-ykbc.onrender.com
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

DISCORD_CLIENT_ID=<จาก Discord Developer Portal>
DISCORD_CLIENT_SECRET=<จาก Discord Developer Portal>
DISCORD_REDIRECT_URI=https://web-ykbc.onrender.com/auth/discord/callback
DISCORD_GUILD_ID=<รหัสเซิร์ฟเวอร์ Discord ของสภา>
ADMIN_DISCORD_IDS=509929220743495693
PRESIDENT_DISCORD_IDS=724900567637295204
VICE_PRESIDENT_DISCORD_IDS=891661520696659968
